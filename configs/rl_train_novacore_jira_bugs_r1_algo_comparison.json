{
  "description": "Train rl agent for novacore_jira_bugs.",
  "action": "train_rl_agent",
  "apply_to_all": false,
  "sync_units": [
    "novacore_jira_bugs"
  ],
  "parameters": {
    "task_type": "event_rate",
    "dataset": {
      "train_ratio": 0.7,
      "val_ratio": 0.15,
      "resample_freq": "1min",
      "covariates": [
        "hour_of_day",
        "day_of_week",
        "is_weekend"
      ],
      "filters": {}
    },
    "agent": {
      "total_timesteps": "auto",
      "dataset_passes": 3,
      "policy_network": [
        64,
        64
      ]
    },
    "env": {
      "episode_length": 1440,
      "prediction_horizon_steps": 10,
      "random_start": true,
      "observation_features": [
        "time_since_last_sync",
        "current_aoi",
        "covariates",
        "cumulative_empty_syncs"
      ]
    },
    "reward": {
      "sync_cost": 1.0,
      "late_penalty": 2.0,
      "successful_sync_reward": 0.5,
      "empty_sync_penalty": 1.0,
      "aoi_penalty_per_minute": 0.01,
      "aoi_threshold_minutes": 5.0
    },
    "predictions": {
      "mode": "none"
    },
    "agents": [
      {
        "agent_name": "ppo_baseline",
        "agent": {
          "algorithm": "PPO",
          "dataset_passes": 3
        }
      },
      {
        "agent_name": "dqn_baseline",
        "agent": {
          "algorithm": "DQN",
          "dataset_passes": 8
        }
      },
      {
        "agent_name": "a2c_baseline",
        "agent": {
          "algorithm": "A2C",
          "dataset_passes": 5
        }
      }
    ]
  }
}
