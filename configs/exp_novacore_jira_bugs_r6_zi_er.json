{
  "description": "Train models for novacore_jira_bugs.",
  "action": "train_models",
  "apply_to_all": false,
  "sync_units": [
    "novacore_jira_bugs"
  ],
  "parameters": {
    "task_type": "event_rate",
    "dataset": {
      "train_ratio": 0.7,
      "val_ratio": 0.15,
      "start_time": "2024-01-01T00:00:00Z",
      "resample_freq": "1h",
      "covariates": [
        "hour_of_day",
        "day_of_week",
        "is_weekend"
      ],
      "filters": {}
    },
    "models": [
      {
        "model_type": "HurdleNB",
        "template_name": "hurdle_nb_v1"
      }
    ],
    "metrics": [
      "mae",
      "rmse",
      "smape",
      "median_ae",
      {
        "name": "aoi_reward",
        "params": {
          "mode": "event_rate",
          "sync_threshold": 300,
          "aoi_threshold_minutes": 5,
          "sync_cost": 1.0,
          "late_penalty": 2.0
        }
      }
    ],
    "cv_folds": 3
  }
}
