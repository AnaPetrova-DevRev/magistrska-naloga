{
  "description": "Train rl agent for novacore_servicenow_novacore_servicenow. Set model_selection.model_id to a user-provided trained model artifact before use.",
  "action": "train_rl_agent",
  "apply_to_all": false,
  "sync_units": [
    "novacore_servicenow_novacore_servicenow"
  ],
  "parameters": {
    "task_type": "event_rate",
    "dataset": {
      "train_ratio": 0.7,
      "val_ratio": 0.15,
      "resample_freq": "1min",
      "covariates": [
        "hour_of_day",
        "day_of_week",
        "is_weekend"
      ],
      "filters": {}
    },
    "agent": {
      "total_timesteps": 200000,
      "validation_evaluations": 20,
      "policy_network": [
