        "current_aoi",
        "covariates",
        "predictions",
        "cumulative_empty_syncs"
      ]
    },
    "reward": {
      "aoi_penalty_per_minute": 0.01,
      "aoi_threshold_minutes": 5.0,
      "empty_sync_penalty": 1.0,
      "late_penalty": 2.0,
      "successful_sync_reward": 0.5,
      "sync_cost": 1.0
    },
    "agents": [
      {
        "agent_name": "a2c_tte_masked_v1_ablation_seed7",
        "agent": {
          "algorithm": "A2C",
          "seed": 7
        },
        "predictions": {
