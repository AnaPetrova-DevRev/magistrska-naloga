{
  "description": "Train rl agent for ecosphere_zendesk_ecosphere_zendesk.",
  "action": "train_rl_agent",
  "apply_to_all": false,
  "sync_units": [
    "ecosphere_zendesk_ecosphere_zendesk"
  ],
  "parameters": {
    "task_type": "event_rate",
    "dataset": {
      "train_ratio": 0.7,
      "val_ratio": 0.15,
      "resample_freq": "1min",
      "covariates": [
        "hour_of_day",
        "day_of_week",
        "is_weekend"
      ],
      "filters": {}
    },
    "env": {
      "episode_length": 1440,
      "random_start": true,
      "observation_features": [
        "time_since_last_sync",
        "current_aoi",
        "covariates",
        "cumulative_empty_syncs"
      ]
    },
    "predictions": {
      "mode": "none"
    },
    "agents": [
      {
        "agent_name": "ppo_auto_seed7",
        "agent": {
          "algorithm": "PPO",
          "dataset_passes": 3,
          "policy_network": [
            64,
            64
          ],
          "seed": 7
        },
        "reward": {
          "preset": "auto"
        }
      }
    ]
  }
}
